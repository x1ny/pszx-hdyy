+/** Split a trailing terminal token ("北京首都 T2" → ["北京首都", "T2"]). */
+function splitTerminal(station: string): { name: string; terminal?: string } {
+  const m = /^(.*?)\s*(T\d+)$/.exec(station.trim())
+  if (m && m[1]) return { name: m[1], terminal: m[2] }
+  return { name: station }
+}
