# Postgres (docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_template

# Better Auth. BETTER_AUTH_URL is the origin the *browser* talks to — in dev
# that is the Vite server, which proxies /api through to apps/server.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Session lifetime in seconds. 28800 = 8 hours; the default is 604800 (7 days).
BETTER_AUTH_SESSION_EXPIRES_IN_SECONDS=604800

# Preferred starting port for apps/server. The root dev runner moves upward
# automatically if this port is occupied and passes the chosen port to Vite.
SERVER_PORT=8787

# Preferred starting port for apps/web during `bun run dev`.
WEB_PORT=3000

# File storage. Relative to the apps/server process working directory.
FILE_STORAGE_DIR=./data/files

# Maximum uploaded file size in bytes (50 MiB by default).
FILE_MAX_SIZE_BYTES=52428800

# 旧项目测试环境（只在需要对照旧行为时用）。真实值填在本地 .env 里，别提交。
LEGACY_TEST_URL=http://10.2.1.16:30053/
LEGACY_TEST_USER=
LEGACY_TEST_PASSWORD=
