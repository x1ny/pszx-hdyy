{
  "name": "fullstack-template",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "bun": ">=1.3.0",
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "docker compose up -d",
    "dev": "bun run --filter '@repo/server' --filter '@repo/web' dev",
    "build": "bun run --filter '@repo/web' build",
    "typecheck": "bun run --filter '@repo/*' typecheck",
    "test": "bun run --filter '@repo/web' test",
    "db:push": "bun run --filter '@repo/db' push",
    "db:generate": "bun run --filter '@repo/db' generate",
    "db:migrate": "bun run --filter '@repo/db' migrate",
    "db:studio": "bun run --filter '@repo/db' studio",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "typescript": "^6.0.2"
  },
  "trustedDependencies": ["esbuild", "lightningcss"]
}
