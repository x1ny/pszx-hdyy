{
  "name": "fullstack-template",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:persist": "bun scripts/dev.ts --persist",
    "build": "bun run docs:api && bun run --filter '@repo/*' build",
    "release": "bun scripts/release.ts",
    "docker:build-push": "bun scripts/build-push.ts",
    "deploy:test": "bun scripts/deploy-test.ts",
    "typecheck": "bun run --filter '@repo/*' typecheck && bunx tsc -p scripts/tsconfig.json --noEmit",
    "test": "bun test scripts && bun run --filter \"@repo/*\" test",
    "docs:api": "bun scripts/gen-api-docs.ts",
    "db:generate": "bun run --filter '@repo/server' db:generate",
    "db:migrate": "bun run --filter '@repo/server' db:migrate",
    "db:baseline": "bun run --filter '@repo/server' db:baseline",
    "db:check": "bun run --filter '@repo/server' db:check",
    "db:studio": "bun run --filter '@repo/server' db:studio",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check --write",
    "postinstall": "bun scripts/setup-git.ts",
    "prune": "bun scripts/prune.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.2"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}
