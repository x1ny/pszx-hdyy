{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"apps/*/src/**/*",
			".vscode/**/*",
			"apps/web/index.html",
			"apps/h5/index.html",
			"apps/*/vite.config.ts",
			"apps/*/vitest.config.ts",
			"apps/*/vitest.setup.ts",
			"apps/*/drizzle.config.ts",
			"scripts/**/*.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"lineEnding": "lf",
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"indentStyle": "space",
			"indentWidth": 2,
			"quoteStyle": "double"
		}
	}
}
