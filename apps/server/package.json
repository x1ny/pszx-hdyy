{
  "name": "@repo/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client-type": "./src/client-type.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --hot run src/index.ts",
    "start": "bun --env-file=../../.env run src/index.ts",
    "auth:generate": "bun run @better-auth/cli generate --config src/modules/auth/auth.ts --output ../../packages/db/src/auth-schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@repo/db": "workspace:*",
    "better-auth": "^1.6.26",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/bun": "^1.3.14"
  }
}
