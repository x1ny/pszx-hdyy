{
  "name": "@repo/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client-type": "./src/client-type.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --hot run src/index.ts",
    "start": "bun --env-file=../../.env run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile dist/server.js",
    "auth:generate": "bun run @better-auth/cli generate --config src/modules/auth/auth.ts --output src/modules/auth/schema.ts",
    "db:push": "bun --env-file=../../.env run drizzle-kit push",
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env run drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "^0.31.10"
  }
}
